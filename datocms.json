{
  "name": "Next.js Blog",
  "description": "Simple blog website built with Next.js and DatoCMS, with real-time updates in preview mode",
  "previewImage": "https://www.datocms-assets.com/205/1605198221-screenshot2020-11-12-next-js-blog-example-with-datocms-1.jpg?crop=top&fit=crop&h=500&w=600&auto=format",
  "datocmsProjectId": "23796",
  "deploymentType": "static",
  "buildCommand": "npm run build",
  "livePreviewUrl": "https://nextjs-demo-bay.vercel.app/",
  "postInstallUrl": "/api/post-install",
  "environmentVariables": {
    "DATOCMS_PUBLISHED_CONTENT_CDA_TOKEN": {
      "type": "datocmsAccessToken",
      "tokenName": "CDA Only (Published)"
    },
    "DATOCMS_DRAFT_CONTENT_CDA_TOKEN": {
      "type": "datocmsAccessToken",
      "tokenName": "CDA Only (Draft)"
    },
    "DATOCMS_CMA_TOKEN": {
      "type": "datocmsAccessToken",
      "tokenName": "CMA Only (Read)"
    }
  }
}
